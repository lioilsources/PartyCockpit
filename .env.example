# PartyCockpit — copy to .env. Never commit .env (the repo is public).

# Listen address and the URL guests' phones reach (goes into the QR on the stage).
# On a LAN party: http://<LAN-IP-of-the-party-box>:8098
PC_ADDR=:8098
PC_PUBLIC_URL=http://PARTY_BOX_LAN_IP:8098
PC_DATA_DIR=./data
# Guards POST /api/parties. Empty = anyone on the LAN can create a party.
PC_ADMIN_TOKEN=
PC_PARTY_TTL=24h
PC_WORKERS=2

# Optional HTTPS (phones only allow the camera on https; needed for browser live streams).
# Use a cert for a name that resolves to the party box on the LAN, and set PC_PUBLIC_URL to it.
PC_TLS_ADDR=:8443
PC_TLS_CERT=
PC_TLS_KEY=
# RTCPeerConnection iceServers as JSON. A LAN party needs none.
PC_ICE_SERVERS=[]

# Slideshow source (FineTuneGallery; behind Cloudflare Access → needs the CF token below)
FINETUNE_URL=https://finetune.example.com
FINETUNE_ALLOW_UNCLASSIFIED=0

# DJfy relay (the host phone publishes now-playing + queue there)
DJFY_URL=https://djfy.example.com

# Restyle: restyler | kontext | mock
RESTYLE_PROVIDER=mock
RESTYLER_API_URL=https://restyler-api.example.com
RESTYLER_APP_TOKEN=
RESTYLER_USER=partycockpit
AISTACK_URL=https://llm.example.com
AISTACK_PROJECT=partycockpit

# Cloudflare Access service token (Restyler API, AiStack, FineTuneGallery)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Animation (living pictures + guest dances): comfy | restyler | mock
ANIMATE_PROVIDER=mock
COMFY_URL=http://127.0.0.1:8188
# Folder with LivePortrait driver clips (<motion>.mp4) uploaded to ComfyUI on first use
PC_DRIVER_DIR=./assets/drivers
PC_ANIM_WORKERS=1

# Moderation classifier: none | aistack (WD14 tagger via AiStack /v1/image/tag)
MODERATION=none
SFW_AUTO_APPROVE_MAX=0.15
