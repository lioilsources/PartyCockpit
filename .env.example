# PartyCockpit — copy to .env. Never commit .env (the repo is public).

# Listen address and the URL guests' phones reach (goes into the QR on the stage).
# On a LAN party: http://<LAN-IP-of-the-party-box>:8098
PC_ADDR=:8098
PC_PUBLIC_URL=http://PARTY_BOX_LAN_IP:8098
PC_DATA_DIR=./data
# Guards POST /api/parties. Empty = anyone on the LAN can create a party, and
# the party list (with cockpit tokens) is never served. Set it outside home use.
PC_ADMIN_TOKEN=
# 1 only behind a reverse proxy: rate limits then key on X-Forwarded-For.
PC_TRUST_PROXY=
PC_PARTY_TTL=24h
PC_WORKERS=2

# Optional HTTPS (phones only allow the camera on https; needed for browser live streams).
# Use a cert for a name that resolves to the party box on the LAN, and set PC_PUBLIC_URL to it.
PC_TLS_ADDR=:8443
PC_TLS_CERT=
PC_TLS_KEY=
# RTCPeerConnection iceServers as JSON. A LAN party needs none.
PC_ICE_SERVERS=[]

# Slideshow source (FineTuneGallery; behind Cloudflare Access → needs the CF token below)
FINETUNE_URL=https://finetune.example.com
FINETUNE_ALLOW_UNCLASSIFIED=0

# Webtoon reader: Toonfork content catalog (public; packs are zips on GitHub Releases,
# imported in the Studio to PC_DATA_DIR/webtoon/packs). Adult packs only with 1.
WEBTOON_CATALOG_URL=https://lioilsources.github.io/webtoon-content/catalog.json
WEBTOON_ALLOW_ADULT=

# Tributes from PromoClown (Studio → 🎨 Tributy). Empty = import off, tributes
# already on disk still play. Use the agent token, never the admin token.
# Only the machine that prepares the show needs it. "mock" = made-up tributes.
# Example: PROMO_API_URL=http://promo-api.example:8094
PROMO_API_URL=
PROMO_TOKEN=

# DJfy relay (the host phone publishes now-playing + queue there)
DJFY_URL=https://djfy.example.com

# Restyle: restyler | comfy (restyle_flux straight on COMFY_URL) | kontext | mock
RESTYLE_PROVIDER=mock
RESTYLER_API_URL=https://restyler-api.example.com
RESTYLER_APP_TOKEN=
RESTYLER_USER=partycockpit
AISTACK_URL=https://llm.example.com
AISTACK_PROJECT=partycockpit

# Cloudflare Access service token (Restyler API, AiStack, FineTuneGallery)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Animation (living pictures + guest dances): comfy | restyler | mock
ANIMATE_PROVIDER=mock
COMFY_URL=http://127.0.0.1:8188
# Optional: Bearer token for a token-checking proxy in front of ComfyUI
COMFY_TOKEN=
# Folder with LivePortrait driver clips (<motion>.mp4) uploaded to ComfyUI on first use
PC_DRIVER_DIR=./assets/drivers
PC_ANIM_WORKERS=1

# Live subtitles (M7): Translator server (../Translator). Empty = typed subtitles only.
# Its ASR worker runs on SPARK only through spark-broker.
TRANSLATOR_URL=
TRANSLATOR_TOKEN=

# Handwritten notes: HandWrittenStickers handwritten_stickers/assets/glyphs
# (sheets.json + one dir per sheet). Empty = notes in the Caveat font.
PC_GLYPHS_DIR=

# Operator UI behind /cockpit/<code> (D21): svelte (default) or react.
# Both are built in; /react/cockpit/<code> is always the React one.
PC_COCKPIT_UI=svelte

# Moderation classifier: none | aistack (WD14 tagger via AiStack /v1/image/tag)
MODERATION=none
SFW_AUTO_APPROVE_MAX=0.15

# Party box (D20, deploy/box/README.md): the stage on the box's own HDMI.
PC_BOX=
# create a party at boot so the TV shows the Cockpit pairing QR
PC_BOX_AUTOPARTY=
PC_BOX_NAME=Party
# 1 = the box stage listens to a USB microphone for the beat
PC_BOX_AUDIO=
# live streams on the wall (default 9; Raspberry Pi 5: 4)
PC_MAX_LIVE=
# shader render scale (default 0.6; Raspberry Pi 5: 0.5)
PC_STAGE_SCALE=
