# PartyCockpit on a party box (Raspberry Pi 5 or a mini PC). All variables:
# .env.example next to this file. After editing: sudo systemctl restart partycockpit kiosk

# --- box mode (D20) ---
PC_BOX=1
# create a party at boot when none is running, so the TV shows the pairing QR
PC_BOX_AUTOPARTY=1
PC_BOX_NAME=Party
# 1 = the stage listens to a USB microphone for the beat (?audio=1)
PC_BOX_AUDIO=0

# --- Raspberry Pi 5 limits (a mini PC with H.264 decoding: 9 and 0.6) ---
PC_MAX_LIVE=4
PC_STAGE_SCALE=0.5

# --- network ---
PC_ADDR=:8098
# the address in the QR on the TV; with a certificate: https://box.example.com:8443
PC_PUBLIC_URL=
PC_TLS_ADDR=:8443
PC_TLS_CERT=
PC_TLS_KEY=
PC_ADMIN_TOKEN=
PC_PARTY_TTL=12h

# --- GPU and services (empty = mock) ---
RESTYLE_PROVIDER=mock
RESTYLER_APP_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
ANIMATE_PROVIDER=mock
COMFY_URL=
TRANSLATOR_URL=
TRANSLATOR_TOKEN=
DJFY_URL=
